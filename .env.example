# Número do WhatsApp de vendas da loja, com DDI e DDD (ex.: 5541995609501)
NEXT_PUBLIC_WHATSAPP_NUMBER=5541995609501

# Endereço público do site
NEXT_PUBLIC_SITE_URL=https://luhgabimports.com.br

# /admin — senha do lojista (mín. 8 caracteres) e segredo do cookie de sessão.
# Sem ADMIN_PASSWORD o /admin responde 503.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Opcional: token para automação/CLI (header x-admin-token), independente do cookie.
ADMIN_API_TOKEN=

# Opcional: caminho alternativo do JSON de configuração da loja.
# STORE_CONFIG_PATH=

# Persistência do /admin na Vercel (recomendado): Upstash Redis / Vercel KV.
# Sem isso, a Vercel grava em /tmp (efêmero e por instância).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa (Upstash direto):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Nome da chave usada no Redis (padrão: luhgab_store_config).
# STORE_CONFIG_KV_KEY=
